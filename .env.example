# Recomendado: mepdetect-user-api/.env (el deploy/dcompose lo prioriza y fusiona en ./.env
# en la raíz para que `docker compose` sin flags tenga POSTGRES_* y no muestre WARN).
# Alternativa: solo .env en la raíz (cp .env.example .env).
#
# MEPDETECT_SYNC_ROOT_DOTENV=0 evita que dcompose sobrescriba ./.env (usa dos --env-file).
#
# --- PostgreSQL (obligatorio para el servicio postgres del compose raíz) ---
# POSTGRES_PASSWORD es la única variable sin default en docker-compose.yml:
# si queda vacía, compose avisa y postgres no arranca.
POSTGRES_DB=mepdetect
POSTGRES_USER=mepdetect
POSTGRES_PASSWORD=

# --- JWT / sesiones (openssl rand -hex 32) ---
# Vacío = el compose usa 'change-me-in-production'. No dejarlo así en producción.
SECRET_KEY=

# --- Puertos en el host (opcional) ---
LANDING_PORT=8090
DETECTION_API_PORT=8091
TRAINING_API_PORT=8092
USER_API_PORT=8093

# --- Mismo servidor que el stack antiguo mepdetect-* (8090-8093 ya ocupados) ---
# Baja el viejo con `docker compose down` en su carpeta, o usa otros puertos, p. ej.:
# LANDING_PORT=18090
# DETECTION_API_PORT=18091
# TRAINING_API_PORT=18092
# USER_API_PORT=18093
# BASE_URL=http://127.0.0.1:18090
# APP_URL=http://127.0.0.1:18090

# --- Modelos YOLO en el host (por defecto ./data/models) ---
# En servidor compartido podría ser: MODELS_HOST_PATH=/opt/mepdetect-shared/models
MODELS_HOST_PATH=./data/models

# --- Stripe ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- reCAPTCHA (SITE_KEY es pública: va en el HTML; SECRET_KEY no) ---
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_ENABLED=true
RECAPTCHA_MIN_SCORE=0.5

# --- Google OAuth (Sign in with Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- URLs públicas (producción: https://mepdetect.com) ---
BASE_URL=http://localhost:8090
APP_URL=http://localhost:8090

# --- Email (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=MEPdetect <noreply@mepdetect.com>

# --- APIs (opcional) ---
LOG_LEVEL=info

# --- Resto de variables que consume docker-compose.yml ---
# Descomenta solo las que quieras cambiar; el valor mostrado es el default
# que ya aplica el compose si la variable no está definida.
# CORS_ORIGINS=https://mepdetect.com,http://localhost:8090,http://127.0.0.1:8090
# JWT_SECRET=            # vacío = hereda SECRET_KEY
# MAX_UPLOAD_SIZE=50MB
# MAX_BATCH_SIZE=50
# DEFAULT_CONFIDENCE=0.25
# DEFAULT_DPI=400
# DETECTION_WORKERS=4
# DETECTION_TIMEOUT=300
# TRAINING_WORKERS=4
# TRAINING_TIMEOUT=3600
# TRAINING_BATCH_SIZE=16
# DEFAULT_EPOCHS=100
# DEFAULT_IMAGE_SIZE=640
# MAX_DATASET_SIZE=1000

# Protege la API de training (train.mepdetect.com): los pesos entrenados son
# IP privada y /api/models/{id}/download los sirve sin autenticacion si esta
# vacia. Generar con: openssl rand -hex 32
TRAINING_API_KEY=

# Recursos del contenedor de deteccion, que es el que hace el trabajo
# pesado (inferencia por tejas sobre hojas completas). OMP_NUM_THREADS
# del compose sigue a DETECTION_CPUS: deben moverse juntos.
# DETECTION_CPUS=8
# DETECTION_MEMORY=6G
