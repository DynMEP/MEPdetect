# Copy to mepdetect-user-api/.env (not committed). Used by ../dcompose and ../deploy.sh.
# cp .env.example .env

# --- PostgreSQL (must match root docker-compose postgres service) ---
# POSTGRES_PASSWORD is the only variable with no default in docker-compose.yml.
POSTGRES_DB=mepdetect
POSTGRES_USER=mepdetect
POSTGRES_PASSWORD=

# For docker compose: use service hostnames postgres / redis (not localhost).
# The password here must match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://mepdetect:CHANGE_ME@postgres:5432/mepdetect
REDIS_URL=redis://redis:6379

# --- JWT (openssl rand -hex 32) ---
# Empty = compose falls back to 'change-me-in-production'. Set both in prod.
SECRET_KEY=
JWT_SECRET_KEY=

# --- YOLO weights on the host (mounted to /app/models in API containers) ---
MODELS_HOST_PATH=/opt/mepdetect/data/models

# --- Puertos host (opcional) ---
LANDING_PORT=8090
DETECTION_API_PORT=8091
TRAINING_API_PORT=8092
USER_API_PORT=8093
BASE_URL=https://mepdetect.com
APP_URL=https://mepdetect.com

# --- Stripe ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- reCAPTCHA (SITE_KEY is public: it ships in the HTML; SECRET_KEY is not) ---
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_ENABLED=true
RECAPTCHA_MIN_SCORE=0.5

# --- Google OAuth (Sign in with Google) ---
# Create credentials: https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized JavaScript origins: https://mepdetect.com, http://localhost:8090
# Authorized redirect URIs: not required for GIS button flow (ID token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (optional) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=MEPdetect <noreply@mepdetect.com>

# --- Everything else docker-compose.yml reads ---
# Uncomment only what you want to change; the value shown is the default the
# compose already applies when the variable is unset.
# LOG_LEVEL=info
# CORS_ORIGINS=https://mepdetect.com,http://localhost:8090,http://127.0.0.1:8090
# JWT_SECRET=            # empty = inherits SECRET_KEY
# MAX_UPLOAD_SIZE=50MB
# MAX_BATCH_SIZE=50
# DEFAULT_CONFIDENCE=0.25
# DEFAULT_DPI=400
# DETECTION_WORKERS=4
# DETECTION_TIMEOUT=300
# TRAINING_WORKERS=4
# TRAINING_TIMEOUT=3600
# TRAINING_BATCH_SIZE=16
# DEFAULT_EPOCHS=100
# DEFAULT_IMAGE_SIZE=640
# MAX_DATASET_SIZE=1000
